+
+static void conv_reset_ftl_stats(struct conv_ftl *conv_ftl)
+{
+	atomic64_set(&conv_ftl->stats.host_write_pages, 0);
+	atomic64_set(&conv_ftl->stats.gc_read_pages, 0);
+	atomic64_set(&conv_ftl->stats.gc_write_pages, 0);
+	atomic64_set(&conv_ftl->stats.gc_count, 0);
+	atomic64_set(&conv_ftl->stats.gc_erase_count, 0);
+}
+
+void conv_reset_stats(struct nvmev_ns *ns)
+{
+	struct conv_ftl *conv_ftls = (struct conv_ftl *)ns->ftls;
+	uint32_t i;
+
+	if (!conv_ftls)
+		return;
+
+	for (i = 0; i < ns->nr_parts; i++)
+		conv_reset_ftl_stats(&conv_ftls[i]);
+}
+
+void conv_print_stats(struct seq_file *m, struct nvmev_ns *ns)
+{
+	struct conv_ftl *conv_ftls = (struct conv_ftl *)ns->ftls;
+	unsigned long long host_write_pages = 0;
+	unsigned long long gc_read_pages = 0;
+	unsigned long long gc_write_pages = 0;
+	unsigned long long gc_count = 0;
+	unsigned long long gc_erase_count = 0;
+	unsigned long long nand_write_pages;
+	unsigned long long waf_x1000 = 0;
+	uint32_t i;
+
+	if (!conv_ftls)
+		return;
+
+	for (i = 0; i < ns->nr_parts; i++) {
+		host_write_pages += atomic64_read(&conv_ftls[i].stats.host_write_pages);
+		gc_read_pages += atomic64_read(&conv_ftls[i].stats.gc_read_pages);
+		gc_write_pages += atomic64_read(&conv_ftls[i].stats.gc_write_pages);
+		gc_count += atomic64_read(&conv_ftls[i].stats.gc_count);
+		gc_erase_count += atomic64_read(&conv_ftls[i].stats.gc_erase_count);
+	}
+
+	nand_write_pages = host_write_pages + gc_write_pages;
+	if (host_write_pages)
+		waf_x1000 = div64_u64(nand_write_pages * 1000, host_write_pages);
+
+	seq_printf(m,
+		   "conv_ftl ns=%u page_size_bytes=%u gc_count=%llu gc_erase_count=%llu "
+		   "host_write_pages=%llu gc_read_pages=%llu gc_write_pages=%llu "
+		   "nand_write_pages=%llu waf=%llu.%03llu\n",
+		   ns->id, (unsigned int)conv_ftls[0].ssd->sp.pgsz, gc_count, gc_erase_count,
+		   host_write_pages, gc_read_pages, gc_write_pages, nand_write_pages,
+		   waf_x1000 / 1000,
+		   waf_x1000 % 1000);
 }
 
